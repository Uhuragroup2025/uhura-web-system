{
  "$schema": "https://tr.designtokens.org/format/v1/schema.json",
  "name": "Uhura Group 2026 - Liquid Glass Design Tokens",
  "version": "3.1.0",
  "description": "Tokens canónicos oficiales de Uhura 2026 unificados con el sitio en producción.",

  "color": {
    "uhura": {
      "ink": { "value": "#17131f", "type": "color", "description": "Texto oscuro en fondos claros" },
      "dark": { "value": "#090513", "type": "color", "description": "Fondo oscuro principal del sitio" },
      "panel": { "value": "#140b24", "type": "color", "description": "Superficie de tarjetas y paneles oscuros" },
      "purple": { "value": "#501f92", "type": "color", "description": "Púrpura insignia" },
      "violet": { "value": "#8a4dff", "type": "color", "description": "CTA claro y resplandores" },
      "lavender": { "value": "#c9b7ff", "type": "color", "description": "Texto secundario en dark mode" },
      "lime": { "value": "#d4ff4a", "type": "color", "description": "Botón CTA en dark mode y KPIs" },
      "lime-light": { "value": "#edff9b", "type": "color", "description": "Extremo claro del degradado lime" },
      "cyan": { "value": "#4be5ff", "type": "color", "description": "Acento tecnológico" },
      "blue": { "value": "#4f7dff", "type": "color", "description": "Acento corporativo" },
      "pink": { "value": "#cd79e8", "type": "color", "description": "Acento secundario" },
      "light": { "value": "#f2ecfb", "type": "color", "description": "Superficie clara con tinte lavanda" },
      "light-2": { "value": "#eaf5ff", "type": "color", "description": "Superficie clara con tinte frío" },
      "white": { "value": "#ffffff", "type": "color" }
    },

    "gradient": {
      "primary": {
        "value": "linear-gradient(135deg, #8a4dff 0%, #501f92 100%)",
        "type": "gradient",
        "description": "Gradiente principal oficial"
      },
      "hero": {
        "value": "linear-gradient(135deg, #501f92 0%, #8a4dff 50%, #4be5ff 100%)",
        "type": "gradient",
        "description": "Gradiente para heros espaciales"
      },
      "holographic": {
        "value": "linear-gradient(135deg, #8a4dff 0%, #4be5ff 50%, #d4ff4a 100%)",
        "type": "gradient",
        "description": "Gradiente holográfico premium"
      },
      "accent": {
        "value": "linear-gradient(135deg, #d4ff4a 0%, #edff9b 100%)",
        "type": "gradient",
        "description": "Gradiente para botón CTA en modo oscuro"
      }
    }
  },

  "typography": {
    "fontFamily": {
      "primary": { "value": "Montserrat, sans-serif", "type": "fontFamily" },
      "editorial": { "value": "Playfair Display, Georgia, serif", "type": "fontFamily" }
    }
  }
}
