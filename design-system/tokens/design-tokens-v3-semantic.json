{
  "$schema": "https://tr.designtokens.org/format/v1/schema.json",
  "name": "Uhura Group 2026 - Unified Semantic Tokens",
  "version": "3.1.0",
  "description": "Tokens semánticos contextuales de Uhura 2026 con soporte explícito de fondos oscuros y claros.",

  "semantic": {
    "color": {
      "background": {
        "dark": "{primitive.color.uhura.dark}",
        "panel": "{primitive.color.uhura.panel}",
        "light": "{primitive.color.uhura.light}",
        "light-alt": "{primitive.color.uhura.light-2}"
      },
      "text": {
        "primary-dark": "{primitive.color.uhura.white}",
        "secondary-dark": "{primitive.color.uhura.lavender}",
        "primary-light": "{primitive.color.uhura.ink}",
        "secondary-light": "rgba(23, 19, 31, 0.66)"
      },
      "cta": {
        "dark-context": {
          "gradient": "linear-gradient(135deg, {primitive.color.uhura.lime} 0%, {primitive.color.uhura.lime-light} 100%)",
          "text": "{primitive.color.uhura.ink}",
          "glow": "0 0 24px rgba(212, 255, 74, 0.35)"
        },
        "light-context": {
          "bg": "{primitive.color.uhura.violet}",
          "text": "{primitive.color.uhura.white}",
          "hover": "{primitive.color.uhura.purple}"
        }
      },
      "gradient": {
        "primary": "linear-gradient(135deg, {primitive.color.uhura.violet} 0%, {primitive.color.uhura.purple} 100%)",
        "hero": "linear-gradient(135deg, {primitive.color.uhura.purple} 0%, {primitive.color.uhura.violet} 50%, {primitive.color.uhura.cyan} 100%)",
        "holographic": "linear-gradient(135deg, {primitive.color.uhura.violet} 0%, {primitive.color.uhura.cyan} 50%, {primitive.color.uhura.lime} 100%)",
        "accent": "linear-gradient(135deg, {primitive.color.uhura.lime} 0%, {primitive.color.uhura.lime-light} 100%)"
      }
    }
  }
}
